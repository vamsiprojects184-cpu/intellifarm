// ECO CROP — Smart Agriculture Platform
// Prisma schema (SQLite). All IDs are cuid strings for consistency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum Role {
  FARMER
  EXPERT
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  mobile          String   @unique
  passwordHash    String
  fullName        String
  role            Role     @default(FARMER)
  preferredLang   String   @default("en")
  state           String?
  district        String?
  village         String?
  farmingExp      String?  // BEGINNER / INTERMEDIATE / EXPERIENCED
  primaryCrop     String?
  farmSizeAcres   Float?
  avatarUrl       String?
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[]
  farms           Farm[]
  diseaseReports  DiseaseReport[]
  recommendations Recommendation[]
  consultations   Consultation[]      @relation("ConsultationFarmer")
  expertProfile   ExpertProfile?
  notifications   Notification[]
  activities      FarmActivity[]
  auditLogs       AuditLog[]
  sensorReadings  SensorReading[]
  irrigationLogs  IrrigationLog[]
  soilTests       SoilTest[]
  harvests        Harvest[]
  pestReports     PestReport[]
  expenses        FarmExpense[]
  tasks           FarmTask[]
  equipment       Equipment[]
  inventory       InventoryItem[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

// ============================================================
// FARM MANAGEMENT
// ============================================================

model Farm {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  state         String
  district      String
  village       String?
  latitude      Float?
  longitude     Float?
  areaAcres     Float
  soilType      String?  // LOAMY / CLAY / SANDY / SILT / BLACK / RED
  irrigationType String? // DRIP / SPRINKLER / FLOOD / RAINFED
  waterSource   String?  // BOREWELL / CANAL / RIVER / POND / RAINFED
  description   String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  crops         Crop[]
  sensors       Sensor[]
  activities    FarmActivity[]
  diseaseReports DiseaseReport[]
  recommendations Recommendation[]
  alerts        Alert[]
  irrigationLogs IrrigationLog[]
  sensorReadings SensorReading[]
  soilTests     SoilTest[]
  harvests      Harvest[]
  pestReports   PestReport[]
  expenses      FarmExpense[]
  tasks         FarmTask[]
  plots         FarmPlot[]
  equipment     Equipment[]
  inventory     InventoryItem[]
}

// ============================================================
// CROP MANAGEMENT
// ============================================================

enum CropStage {
  PLANNED
  PLANTED
  GERMINATION
  VEGETATIVE
  FLOWERING
  FRUITING
  HARVEST_READY
  HARVESTED
}

enum CropHealth {
  EXCELLENT
  GOOD
  NEEDS_ATTENTION
  CRITICAL
}

model Crop {
  id              String   @id @default(cuid())
  farmId          String
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name            String
  variety         String?
  plantingDate    DateTime
  expectedHarvest DateTime?
  stage           CropStage @default(PLANNED)
  areaAcres       Float
  health          CropHealth @default(GOOD)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities      FarmActivity[]
  diseaseReports  DiseaseReport[]
  recommendations Recommendation[]
  harvests        Harvest[]
  soilTests       SoilTest[]
  pestReports     PestReport[]
  expenses        FarmExpense[]
  tasks           FarmTask[]
}

model FarmActivity {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String   // PLANTING / IRRIGATION / FERTILIZER / PESTICIDE / DISEASE_OBS / HARVEST / WEATHER / DISEASE_SCAN / OTHER
  title       String
  description String?
  metadata    String?  // JSON string
  isAuto      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============================================================
// SENSORS & MONITORING
// ============================================================

model Sensor {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  sensorId    String   // external id from device
  name        String
  type        String   // SOIL_MOISTURE / TEMPERATURE / HUMIDITY / WATER_LEVEL
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  readings    SensorReading[]
}

model SensorReading {
  id           String   @id @default(cuid())
  sensorId     String
  sensor       Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  reportedBy   String?
  user         User?    @relation(fields: [reportedBy], references: [id], onDelete: SetNull)
  soilMoisture Float?   // %
  temperature  Float?   // °C
  humidity     Float?   // %
  waterLevel   Float?   // %
  isManual     Boolean  @default(false)
  isAnomaly    Boolean  @default(false)
  anomalyNote  String?
  timestamp    DateTime @default(now())
}

// ============================================================
// WEATHER
// ============================================================

model WeatherRecord {
  id           String   @id @default(cuid())
  farmId       String?
  state        String
  district     String?
  temperature  Float
  humidity     Float
  rainProbability Float
  windSpeed    Float
  condition    String   // CLEAR / CLOUDY / RAIN / THUNDERSTORM / FOG
  description  String?
  forecastDate DateTime
  isForecast   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ============================================================
// IRRIGATION
// ============================================================

model IrrigationLog {
  id           String   @id @default(cuid())
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId       String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  waterLitres  Float
  durationMin  Int
  method       String?  // DRIP / SPRINKLER / FLOOD
  notes        String?
  performedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
}

model IrrigationConfig {
  id              String   @id @default(cuid())
  cropName        String   @unique
  moistureThreshold Float   @default(35)  // % below which irrigate
  tempThreshold   Float    @default(32)   // °C above which increase water
  rainThreshold   Float    @default(60)   // % rain prob above which skip
  baseWaterLitres Float    @default(500)  // per acre per session
  baseDurationMin Int      @default(45)
  notes           String?
}

// ============================================================
// DISEASE DETECTION
// ============================================================

model DiseaseReport {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId        String?
  crop          Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl      String
  cropName      String
  predictedDisease String?
  confidence    Float?   // 0-1
  severity      String?  // LOW / MODERATE / HIGH / SEVERE
  symptoms      String?
  recommendedAction String?
  preventionTips String?
  status        String   @default("ANALYZED") // ANALYZED / REVIEWED / CLOSED
  expertNotes   String?
  createdAt     DateTime @default(now())
}

model DiseaseDatabase {
  id              String   @id @default(cuid())
  cropName        String
  diseaseName     String
  symptoms        String
  cause           String?
  severity        String
  treatment       String
  prevention      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// RECOMMENDATIONS & ALERTS
// ============================================================

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId      String?
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  category    String   // IRRIGATION / DISEASE / WEATHER / FERTILIZER / CROP / RISK / MARKET / SCHEME
  title       String
  description String
  priority    Priority @default(MEDIUM)
  status      String   @default("PENDING") // PENDING / COMPLETED / DISMISSED
  source      String   @default("RULE_ENGINE") // RULE_ENGINE / LLM / EXPERT
  createdAt   DateTime @default(now())
}

model Alert {
  id          String   @id @default(cuid())
  userId      String?
  farmId      String?
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  category    String   // WEATHER / IRRIGATION / DISEASE / SENSOR / CROP / MARKET / SCHEME
  title       String
  message     String
  priority    Priority @default(MEDIUM)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  title     String
  message   String
  priority  Priority @default(MEDIUM)
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ============================================================
// MARKET PRICES
// ============================================================

model Market {
  id        String   @id @default(cuid())
  name      String
  state     String
  district  String?
  createdAt DateTime @default(now())

  prices    MarketPrice[]
}

model MarketPrice {
  id          String   @id @default(cuid())
  cropName    String
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  minPrice    Float    // ₹ per quintal
  maxPrice    Float
  modalPrice  Float
  priceDate   DateTime
  isDemo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// GOVERNMENT SCHEMES
// ============================================================

model GovernmentScheme {
  id              String   @id @default(cuid())
  name            String
  description     String
  eligibility     String
  benefits        String
  requiredDocs    String
  applicationProcess String
  officialSource  String
  officialUrl     String?
  state           String   // "ALL" for central
  category        String   // SUBSIDY / INSURANCE / LOAN / EQUIPMENT / TRAINING / INCOME_SUPPORT
  level           String   @default("CENTRAL") // CENTRAL / STATE
  isActive        Boolean  @default(true)
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ============================================================
// EXPERT CONSULTATION
// ============================================================

model ExpertProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  experience  Int      @default(0)
  qualification String?
  bio         String?
  isVerified  Boolean  @default(false)
  rating      Float    @default(0)
  totalConsultations Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consultations Consultation[] @relation("ConsultationExpert")
}

model Consultation {
  id          String   @id @default(cuid())
  farmerId    String
  farmer      User     @relation("ConsultationFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  expertId    String?
  expert      ExpertProfile? @relation("ConsultationExpert", fields: [expertId], references: [id], onDelete: SetNull)
  category    String   // CROP_DISEASE / IRRIGATION / SOIL / FERTILIZER / PEST / GENERAL
  subject     String
  question    String
  imageUrl    String?
  status      String   @default("OPEN") // OPEN / IN_PROGRESS / ANSWERED / CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    ConsultationMessage[]
}

model ConsultationMessage {
  id             String   @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     String   // FARMER / EXPERT
  message        String
  createdAt      DateTime @default(now())
}

// ============================================================
// CROP REFERENCE DATABASE
// ============================================================

model CropDatabase {
  id            String   @id @default(cuid())
  name          String   @unique
  scientificName String?
  category      String   // CEREAL / PULSE / OILSEED / VEGETABLE / FRUIT / CASH / SPICE
  season        String   // KHARIF / RABI / ZAID / ALL
  durationDays  Int?
  waterNeed     String?  // LOW / MEDIUM / HIGH
  description   String?
  createdAt     DateTime @default(now())
}

// ============================================================
// SOIL TEST REPORTS
// ============================================================

model SoilTest {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId        String?
  crop          Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testDate      DateTime @default(now())
  ph            Float?   // 0-14
  nitrogen      Float?   // kg/ha (N)
  phosphorus    Float?   // kg/ha (P)
  potassium     Float?   // kg/ha (K)
  organicCarbon Float?   // %
  ec            Float?   // electrical conductivity dS/m
  sulfur        Float?
  iron          Float?
  zinc          Float?
  boron         Float?
  soilMoisture  Float?   // %
  texture       String?  // LOAMY / CLAY / SANDY / SILT
  fertility     String   @default("MEDIUM") // LOW / MEDIUM / HIGH
  labName       String?
  notes         String?
  recommendations String? // JSON string of fertilizer recommendations
  createdAt     DateTime @default(now())
}

// ============================================================
// HARVEST & YIELD TRACKING
// ============================================================

model Harvest {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId        String
  crop          Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  harvestDate   DateTime @default(now())
  quantityKg    Float    // total harvest in kg
  areaAcres     Float    // area harvested
  yieldPerAcre  Float    // kg/acre (computed)
  quality       String   @default("GOOD") // EXCELLENT / GOOD / AVERAGE / POOR
  salePrice     Float?   // ₹ per kg
  totalIncome   Float?   // ₹ (computed)
  expenses      Float?   // ₹ total input cost
  netProfit     Float?   // ₹ (computed)
  buyer         String?  // who purchased
  notes         String?
  createdAt     DateTime @default(now())
}

// ============================================================
// FERTILIZER RECOMMENDATIONS (reference DB)
// ============================================================

model FertilizerRecommendation {
  id            String   @id @default(cuid())
  cropName      String
  growthStage   String   // PLANTED / VEGETATIVE / FLOWERING / FRUITING
  nitrogen      Float    // kg/acre recommended
  phosphorus    Float    // kg/acre
  potassium     Float    // kg/acre
  fertilizer    String   // recommended fertilizer name e.g. "NPK 19-19-19"
  quantity      String   // per acre
  timing        String   // when to apply
  notes         String?
  createdAt     DateTime @default(now())
}

// ============================================================
// PEST & PESTICIDE MANAGEMENT
// ============================================================

model PestReport {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId        String?
  crop          Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pestName      String
  severity      String   @default("MEDIUM") // LOW / MEDIUM / HIGH / SEVERE
  affectedArea  Float?   // acres
  observedDate  DateTime @default(now())
  treatment     String?  // pesticide used
  treatmentDate DateTime?
  status        String   @default("ACTIVE") // ACTIVE / TREATED / MONITORING
  notes         String?
  imageUrl      String?
  createdAt     DateTime @default(now())
}

model PesticideDatabase {
  id            String   @id @default(cuid())
  pestName      String
  cropName      String
  pesticideName String
  chemicalName  String?
  dosage        String   // per acre
  method        String   // SPRAY / DUST / SOIL / SEED_TREATMENT
  timing        String   // when to apply
  waitingPeriod String?  // days to harvest after application
  precaution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// FARM EXPENSES / FINANCE
// ============================================================

model FarmExpense {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId        String?
  crop          Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String   // SEEDS / FERTILIZER / PESTICIDE / LABOR / FUEL / EQUIPMENT / IRRIGATION / LAND_RENT / OTHER
  description   String
  amount        Float    // ₹
  expenseDate   DateTime @default(now())
  vendor        String?
  paymentMode   String?  // CASH / UPI / BANK / CREDIT
  receiptNo     String?
  notes         String?
  createdAt     DateTime @default(now())
}

// ============================================================
// FARM TASKS & REMINDERS
// ============================================================

model FarmTask {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String   @default("GENERAL") // PLANTING / IRRIGATION / FERTILIZER / PESTICIDE / HARVEST / INSPECTION / OTHER
  priority    String   @default("MEDIUM") // LOW / MEDIUM / HIGH
  dueDate     DateTime
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
}

// ============================================================
// FARM PLOTS / FIELD LAYOUT
// ============================================================

model FarmPlot {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name        String
  cropName    String?
  areaAcres   Float
  // Grid-based layout: position on a 10x10 grid (0-100 percentage)
  x           Float    @default(0)  // 0-100
  y           Float    @default(0)  // 0-100
  width       Float    @default(20) // 0-100
  height      Float    @default(20) // 0-100
  color       String   @default("#16a34a")
  soilType    String?
  currentCrop String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// EQUIPMENT & INVENTORY MANAGEMENT
// ============================================================

model Equipment {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      String   // TRACTOR / PUMP / SPRAYER / HARVESTER / TILLER / IRRIGATION / OTHER
  brand         String?
  model         String?
  purchaseDate  DateTime?
  purchasePrice Float?
  currentValue  Float?
  status        String   @default("ACTIVE") // ACTIVE / MAINTENANCE / BROKEN / SOLD
  lastService   DateTime?
  nextService   DateTime?
  hoursUsed     Float?
  fuelType      String?  // DIESEL / PETROL / ELECTRIC / MANUAL
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InventoryItem {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      String   // SEEDS / FERTILIZER / PESTICIDE / FUEL / TOOLS / OTHER
  quantity      Float
  unit          String   @default("kg") // kg / L / pieces / bags
  minStock      Float    @default(0)
  pricePerUnit  Float?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  batchNo       String?
  supplier      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}